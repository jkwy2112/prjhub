# ===== 基础 =====
APP_NAME=PrjHub
SECRET_KEY=please-change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
# 生产环境可切换 PostgreSQL: postgresql+psycopg2://user:pass@host:5432/prjhub
DATABASE_URL=sqlite:///./data/prjhub.db
REPOS_DIR=./repos
GIT_INITIAL_BRANCH=main
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 首次启动自动创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== LDAP 集中认证 =====
LDAP_ENABLED=false
LDAP_SERVER=ldap://ldap.example.com:389
LDAP_USE_SSL=false
# 用于搜索用户的服务账号
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=secret
LDAP_SEARCH_BASE=ou=people,dc=example,dc=com
# OpenLDAP 用 (uid={login}), Active Directory 用 (sAMAccountName={login})
LDAP_SEARCH_FILTER=(uid={login})
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_DISPLAY_NAME=cn
LDAP_ATTR_EMAIL=mail

# ===== 企业微信 (WeCom) OAuth =====
WECOM_ENABLED=false
WECOM_CORP_ID=ww1234567890abcdef
WECOM_CORP_SECRET=your-corpsecret
WECOM_AGENT_ID=1000002
